# INDUS AI Backend - Environment Configuration Template

# ── Environment ───────────────────────────────────────────────────────────────
APP_ENV=development

# ── Database Configuration ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=indus_ai
DB_USER=postgres
DB_PASSWORD=your_database_password_here
# DATABASE_URL is constructed automatically, but can be overridden:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/indus_ai

# ── JWT Security Configuration ────────────────────────────────────────────────
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=indus-ai-dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM Provider Configuration ────────────────────────────────────────────────
# Supported Providers: gemini, groq
LLM_PROVIDER=gemini

# Provide the API key for your chosen LLM Provider
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
