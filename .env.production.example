# ══════════════════════════════════════════════════════════════════════════════
# INDUS AI - Production Environment Variables
# ══════════════════════════════════════════════════════════════════════════════

# ── General Settings ─────────────────────────────────────────────────────────
APP_ENV=production
FRONTEND_PORT=80

# ── Database Settings (PostgreSQL) ───────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=indus_ai
DB_USER=postgres
DB_PASSWORD=replace_with_a_very_secure_db_password_here

# ── Security & Authentication ────────────────────────────────────────────────
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_64_char_hex_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM Provider Configuration ───────────────────────────────────────────────
# Options: groq | gemini
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend API URL (Optional) ──────────────────────────────────────────────
# Leave empty if using the built-in Nginx reverse proxy on the same domain,
# or specify the backend public URL (e.g., https://api.yourdomain.com)
VITE_API_URL=
